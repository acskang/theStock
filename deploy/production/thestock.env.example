DJANGO_SECRET_KEY=replace-with-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stock.thesysm.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://stock.thesysm.com
DJANGO_SETTINGS_MODULE=stock_service.settings.prod
DJANGO_LOG_DIR=/logs/thestock
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

POSTGRES_DB=stock_workbench
POSTGRES_USER=stock_workbench
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

APP_VERSION=prod
APP_BUILD_SHA=unknown
READINESS_CHECK_MIGRATIONS=1
LEGACY_PORTFOLIO_USERNAME=demo
OPENDART_API_KEY=
DATA_PIPELINE_PROVIDER=auto

# Toss Invest OpenAPI
TOSS_INVEST_PROVIDER_ENABLED=false
TOSS_INVEST_BASE_URL=https://openapi.tossinvest.com
TOSS_INVEST_TOKEN_URL=
TOSS_INVEST_CLIENT_ID=
TOSS_INVEST_CLIENT_SECRET=
TOSS_INVEST_ACCOUNT_ID=
TOSS_REQUEST_TIMEOUT_SECONDS=10
TOSS_MAX_RETRIES=2
TOSS_RATE_LIMIT_PER_MINUTE=60
TOSS_ORDER_EXECUTION_ENABLED=false
TOSS_USER_CREDENTIAL_UI_ENABLED=false
TOSS_USER_HOLDINGS_APPLY_ENABLED=false
TOSS_HOLDINGS_APPLY_CONFIRM_TTL_SECONDS=600

STATIC_URL=/static/
STATIC_ROOT=/home/cskang/ganzskang/theStock/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/home/cskang/ganzskang/theStock/media

THEPEACH_AUTH_BASE_URL=http://127.0.0.1
THEPEACH_LOGIN_BASE_URL=http://127.0.0.1
THEPEACH_PUBLIC_BASE_URL=https://peach.thesysm.com
THEPEACH_UPSTREAM_HOST_HEADER=peach.thesysm.com
THEPEACH_SSO_ACCESS_COOKIE_NAME=thepeach_sso_access
THEPEACH_SSO_REFRESH_COOKIE_NAME=thepeach_sso_refresh
THEPEACH_SSO_COOKIE_DOMAIN=.thesysm.com
THEPEACH_SSO_COOKIE_PATH=/
THEPEACH_SSO_COOKIE_SAMESITE=Lax
THEPEACH_SSO_COOKIE_SECURE=true
THEPEACH_AUTH_TIMEOUT=10
